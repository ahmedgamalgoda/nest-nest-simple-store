// use prisma-8

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("user")
  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String?
  price       Float
  stock       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   temporal.updatedAt()
}

model Order {
  id         String      @id @default(uuid())
  userId     String
  totalPrice Float
  status     String      @default("completed")
  createdAt  DateTime    @default(now())
  updatedAt  temporal.updatedAt()
  items      OrderItem[]
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  productId String
  quantity  Int
  price     Float
}
